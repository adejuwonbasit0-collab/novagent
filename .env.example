# Copy this to .env in the repo root before running `docker compose up -d`.
# This is for HOSTING backend + dashboard together (see docker-compose.yml).
# It is separate from backend/.env, which is only used for local dev
# without Docker (uvicorn --reload against backend/docker-compose.yml's
# postgres+redis only).

POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_password
POSTGRES_DB=nova_db

# Required — generate one long random value, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=

# Set this to your actual public dashboard URL once you have one
# (e.g. https://app.yournova.com) -- it's what the backend allows as a
# CORS origin, and it's the same host your users' desktop agents and
# browser extensions will be told to talk to.
CORS_ORIGINS=http://localhost:3000

# Get a key at https://console.anthropic.com — without this, the backend
# starts fine but /assistant/chat (and therefore any actual AI
# conversation) will fail. Everything else (auth, devices, reminders,
# admin) works without it.
ANTHROPIC_API_KEY=

# "mock" needs no key and is fully testable — see
# backend/app/services/voice_providers/elevenlabs.py's docstring before
# switching this to "elevenlabs" for production voice cloning.
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
