# BUG FIX: the previous .gitignore was UTF-16LE-encoded (BOM + null bytes
# between every character). Git, pip, and every other tool that reads
# .gitignore expects UTF-8/ASCII line-based text -- a UTF-16 file doesn't
# error, it just silently matches NOTHING, because "venv*\n" in UTF-16
# bytes never appears as a substring match against any real UTF-8 path.
# That's why a venv folder ended up committed to the repo despite this
# file supposedly excluding it. Rewritten here as plain UTF-8.
#
# Convention: each subproject (backend/, desktop-agent/) gets its OWN
# .venv, created inside that subproject's folder, never at the repo root.
# "python -m venv .venv" from inside backend/ or desktop-agent/ (per
# HOW_TO_RUN.md) satisfies these patterns automatically.

# Python virtual environments (any name/location, any subproject)
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/

__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node / dashboard
node_modules/
.next/
out/

# Env files (never commit real secrets)
.env
!.env.example
backend/.env
!backend/.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.log

# Local data that should never be committed
backend/data/voice_samples/*
!backend/data/voice_samples/.gitkeep
*.db
*.sqlite
*.sqlite3
test_nova.db
