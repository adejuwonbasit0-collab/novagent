# --- App ---
APP_NAME=Nova Assistant Platform
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://nova:nova_password@localhost:5432/nova_db

# --- Redis (sessions/rate-limiting/celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Device tokens ---
DEVICE_TOKEN_EXPIRE_DAYS=90

# --- AI orchestration ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PENDING_CONFIRMATION_TTL_MINUTES=5

# --- Voice training/synthesis ---
# "mock" needs no key and is fully testable locally — real voice cloning
# needs "elevenlabs" + a key from https://elevenlabs.io (NOT verified
# against the real API in this dev environment — see
# app/services/voice_providers/elevenlabs.py's docstring before relying on it)
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
VOICE_STORAGE_DIR=./data/voice_samples
MAX_VOICE_SAMPLE_BYTES=26214400
